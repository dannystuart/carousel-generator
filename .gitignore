# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source imagery. `pnpm prep:images` turns these into the committed webp in
# public/img/, which is what ships — 92MB of prototype PNGs that get swapped
# later has no business in a public repo's permanent history.
/images/
/assets-source/

# Screenshots from scripts/shoot-catalogue.mjs — a tuning aid, not an artefact.
/.shots/

# Reference screenshots of other people's websites. Local working material for
# tuning the styles against; not ours to redistribute.
/Carousel Inspiration/

# The product spec. Holds the keyword research, the search volumes and the
# commercial reasoning — Danny's call, 10 Aug 2026, that those stay off a public
# repo. It is also purged from the history before the first push, because it was
# added in the very first commit and deleting it forward would leave it readable
# in the log. Keep reading it at docs/private/; it just never gets committed.
/docs/private/

# Playwright scratch: actual/diff images from a failed run, and its last-run marker.
/test-results/
